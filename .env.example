# STEG Smart Monitoring - Environment Configuration
#
# Copy this file to .env and fill in the actual values for your environment
# IMPORTANT: Never commit .env to the repository
# IMPORTANT: Never use these example values in production
#
# Local Development:
#   Copy to .env and set realistic values
#
# Production:
#   Set these as system environment variables or container secrets

# ==========================
# Database Configuration
# ==========================

# PostgreSQL Connection URL
# Format: jdbc:postgresql://host:port/database
DB_URL=jdbc:postgresql://localhost:5432/steg_monitoring

# PostgreSQL Username
DB_USERNAME=postgres

# PostgreSQL Password
# IMPORTANT: Change this from the default in production
DB_PASSWORD=postgres

# ==========================
# JWT Configuration
# ==========================

# JWT Signing Secret
# IMPORTANT: Must be a long, random, secure string in production
# Generate a secure secret using:
#   Linux/Mac: openssl rand -base64 64
#   Windows: Use an online generator or security tool
# Minimum recommended length: 64 characters
JWT_SECRET=your-long-random-secure-jwt-secret-minimum-64-characters-change-this

# JWT Token Expiration (in milliseconds)
# Default: 86400000 = 24 hours
# Examples:
#   3600000 = 1 hour
#   86400000 = 24 hours
#   604800000 = 7 days
JWT_EXPIRATION=86400000

# ==========================
# Notes
# ==========================
#
# For Local Development:
# 1. Copy this file to .env
# 2. Update values as needed for your local environment
# 3. Run: export $(cat .env | xargs)  (Linux/Mac)
#    Or set them manually in your IDE/terminal
#
# For Production Deployment:
# 1. Never use this .env file
# 2. Set environment variables in your deployment platform
# 3. Use Docker secrets or your cloud provider's secret management
# 4. Ensure JWT_SECRET is truly random and secure
#
# Previous Secrets (COMPROMISED - DO NOT USE):
# - Old PostgreSQL username: steg_admin (COMPROMISED)
# - Old PostgreSQL password: steg_password (COMPROMISED)
# - Old JWT secret: 4fd86f2c89e0bcb54b4c37a90c2f7d4d5d7a6c8b9e1f0a... (COMPROMISED)
# These were exposed in the repository and must not be reused.
